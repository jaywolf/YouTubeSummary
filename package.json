{
  "name": "youtube-summary-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "build:test": "WXT_TEST_MODE=1 wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:manifest": "pnpm build && node tests/manifest.mjs production",
    "test:manifest:test": "pnpm build:test && node tests/manifest.mjs test",
    "test:extension": "pnpm build:test && playwright test",
    "clean": "rm -rf dist dist-test",
    "check": "pnpm typecheck && pnpm test && pnpm test:manifest && pnpm test:manifest:test"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@wxt-dev/module-react": "1.2.2",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wxt": "0.20.27"
  }
}
